{
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "EXTENSION_STATIC_BUILD": "1"
      },
      "warnings": {
        "dev": true,
        "deprecated": true,
        "unusedCli": true,
        "uninitialized": false
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "description": "Optimized release build",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "description": "Debug build with ASan/UBSan enabled",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LOGSEARCH_ENABLE_ASAN": "ON",
        "LOGSEARCH_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "reldebinfo",
      "inherits": "base",
      "description": "Release build with debug info and DuckDB assertions, no sanitizers",
      "binaryDir": "${sourceDir}/build/reldebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-DDUCKDB_FORCE_ASSERT",
        "CMAKE_C_FLAGS": "-DDUCKDB_FORCE_ASSERT"
      }
    },
    {
      "name": "release-lint",
      "inherits": "release",
      "description": "Release build with linting (clang-tidy, cppcheck) enabled",
      "binaryDir": "${sourceDir}/build/release-lint",
      "cacheVariables": {
        "ENABLE_LINTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "configurePreset": "release",
      "name": "release"
    },
    {
      "configurePreset": "debug",
      "name": "debug"
    },
    {
      "configurePreset": "reldebinfo",
      "name": "reldebinfo"
    },
    {
      "configurePreset": "release-lint",
      "name": "release-lint"
    }
  ],
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "version": 8
}
