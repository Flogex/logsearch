---
# Curated check set. Enable broad families, then opt out of known-noisy or
# stylistic-only checks.
Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-nodiscard,
  -modernize-use-trailing-return-type,
  -portability-avoid-pragma-once,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-named-parameter,
  google-explicit-constructor,
  google-build-namespaces,
  google-readability-casting,

WarningsAsErrors: '*,-modernize-avoid-c-arrays'

# Per-invocation --header-filter (set in CMake) narrows this further to the
# extension's own headers. Left permissive here so direct clang-tidy runs work.
HeaderFilterRegex: '.*'

FormatStyle: file
