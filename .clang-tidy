---
# Enable broad families, then opt out of known-noisy or stylistic-only checks.
Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-auto,
  -modernize-use-trailing-return-type,
  -portability-avoid-pragma-once,
  -readability-identifier-length,
  google-explicit-constructor,
  google-build-namespaces,
  google-readability-casting,

WarningsAsErrors: '*,-modernize-avoid-c-arrays'

# Per-invocation --header-filter (set in CMake) narrows this further to the
# extension's own headers. Left permissive here so direct clang-tidy runs work.
HeaderFilterRegex: '.*'

FormatStyle: file
